# Your OpenAI API key (script + voiceover + images all use OpenAI).
# If unset, the app runs in MOCK mode (placeholder outputs) so you can try it free.
OPENAI_API_KEY=

# Optional: point at a compatible OpenAI-style endpoint (Azure, local proxy, etc.)
# OPENAI_BASE_URL=

# Optional: force mock mode even if a key is present (testing/demo)
# MOCK=1
